# Lion AI Studios — settings. Copy to studio.env and edit. Quote any value that contains spaces.
# Read by systemd (EnvironmentFile=), by scripts/download_models.py, and by `set -a; . ./studio.env; set +a` in a shell.

# ── the studio ──────────────────────────────────────────────────────────────────────────
STUDIO_HOME="$HOME/lion-studio"          # library, state, uploads, voices, helper envs and the studio's own models
STUDIO_HOST=127.0.0.1                     # keep it local; use an authenticating reverse proxy for remote access
STUDIO_PORT=8482

# ── ComfyUI (the renderer) ──────────────────────────────────────────────────────────────
COMFY_DIR="$HOME/ComfyUI"
COMFY_URL=http://127.0.0.1:8188
COMFY_MODELS="$HOME/ComfyUI/models"
COMFY_SERVICE=comfyui.service             # systemd --user unit the studio may start on demand; empty = never start it

# ── the director: an OpenAI-compatible chat server that accepts video input ─────────────
DIRECTOR_URL=http://127.0.0.1:8486
DIRECTOR_MODEL=studio-director            # the served model name
DIRECTOR_LABEL="Qwen3.8-27B director"     # how the page names it
DIRECTOR_SERVICE=                         # optional systemd --user unit, started on first use (e.g. lion-director.service)

# optional: a second, text-only LLM that writes prompts whenever it answers (reviews always use the director)
WRITER_URL=
WRITER_MODEL=
WRITER_LABEL=

# ── optional: another GPU service the studio may pause before rendering (it asks you first) ─
GPU_TENANT_NAME=                          # e.g. "the vLLM server"
GPU_TENANT_CHECK=                         # exits 0 while it runs, e.g. "systemctl --user is-active -q vllm.service"
GPU_TENANT_STOP=                          # e.g. "systemctl --user stop vllm.service"
GPU_TENANT_START=                         # e.g. "systemctl --user start vllm.service"

# ── guards ──────────────────────────────────────────────────────────────────────────────
STUDIO_NEED_GIB=55                        # free unified memory (GiB) a render waits for when ComfyUI is not yet loaded
STUDIO_HOT_C=95                           # pause between segments at this board temperature (°C)...
STUDIO_COOL_C=85                          # ...and resume below this one

# ── helper environments (scripts/setup_envs.sh creates them here) ───────────────────────
STUDIO_TTS_PY="$HOME/lion-studio/envs/tts/bin/python"
STUDIO_MIDI_PY="$HOME/lion-studio/envs/midi/bin/python"
STUDIO_SF2="$HOME/lion-studio/models/soundfonts/MuseScore_General.sf2"
TENSORFOLD_LIB="$HOME/ComfyUI/custom_nodes/tensorfold_h3/libtf_h3.so"   # optional engine; the studio falls back to ComfyUI without it

# ── optional: Ming-Image-0.1-Design, an image model that runs outside ComfyUI (docs/MING.md) ──────────
# The Image menu lists it only when all three exist. These are the defaults; change them if you put things elsewhere.
MING_MODEL="$HOME/lion-studio/models/Ming-Image-0.1-Design"   # the weights (inclusionAI/Ming-Image-0.1-Design, 53 GB)
MING_CODE="$HOME/lion-studio/ming/Ming-Image"                 # a checkout of github.com/inclusionAI/Ming-Image
MING_PY="$HOME/lion-studio/envs/ming/bin/python"              # the venv that runs it
